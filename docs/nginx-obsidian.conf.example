# Nginx: Obsidian reverse-proxy example
#
# Add this as a server block using your existing TLS/certificate conventions.
# Do NOT add analogous blocks for Honcho, Syncthing, Ollama, PostgreSQL or Redis.
# Those services remain localhost/private-LAN only in phase 1.

server {
    listen 443 ssl http2;
    server_name obsidian.innamorato.duckdns.org;

    # Reuse your existing DuckDNS TLS certificate directives here.
    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    location / {
        # Obsidian container uses a self-signed local certificate.
        proxy_pass https://127.0.0.1:18401;
        proxy_ssl_verify off;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Required for the Selkies/Kasm browser GUI websocket streams.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
