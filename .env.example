# Generated secrets belong in .env. Never commit that file.
POSTGRES_DB=honcho
POSTGRES_USER=honcho
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local validation: services are localhost-only, so authentication can stay off.
# Production: set AUTH_USE_AUTH=true and create a scoped key/JWT for Hermes.
AUTH_USE_AUTH=false
# AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

HONCHO_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
LOG_LEVEL=INFO
TELEMETRY_ENABLED=false
METRICS_ENABLED=false
VECTOR_STORE_TYPE=pgvector

# Native Ollama on macOS: host.docker.internal reaches the Metal-accelerated host process.
# On Ubuntu using a containerized Ollama, use http://ollama:11434/v1 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LLM_OPENAI_API_KEY=ollama

# 4B is deliberately chosen for an M1 Pro with 16 GB RAM. Qwen3 supports tools.
LOCAL_CHAT_MODEL=qwen3:4b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VECTOR_DIMENSIONS=768
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=always
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=${LOCAL_EMBEDDING_MODEL}
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}

# All Honcho agents must use an OpenAI-compatible endpoint and a tool-capable model.
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object
DERIVER_REPRESENTATION_BATCH_WORK_UNIT_TARGET_TOKENS=0
DERIVER_REPRESENTATION_BATCH_MAX_AGE_SECONDS=60

SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}

DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=${LOCAL_CHAT_MODEL}
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=${OLLAMA_BASE_URL}

# Keep development latency/resource use predictable. Turn on after basic validation.
DREAM_ENABLED=false

# =============================================================================
# Obsidian vault UI (optional compose.obsidian.yaml)
# =============================================================================
# On Ubuntu use /srv/hermes/vault and /srv/obsidian/config, owned by the mapped UID/GID.
# Local bootstrap replaces LOCAL_UID/LOCAL_GID with the current macOS identity.
OBSIDIAN_PUID=LOCAL_UID
OBSIDIAN_PGID=LOCAL_GID
OBSIDIAN_VAULT_PATH=./runtime/vault
OBSIDIAN_CONFIG_PATH=./runtime/obsidian-config
OBSIDIAN_HTTPS_PORT=3001
TZ=Europe/Zurich

# =============================================================================
# Syncthing vault synchronization (optional compose.syncthing.yaml)
# =============================================================================
# The GUI remains localhost-only. The remaining three ports are for paired peers
# on the private LAN; protect them with the server firewall if the LAN is shared.
SYNCTHING_PUID=LOCAL_UID
SYNCTHING_PGID=LOCAL_GID
SYNCTHING_CONFIG_PATH=./runtime/syncthing-config
SYNCTHING_GUI_PORT=8384
SYNCTHING_LISTEN_BIND=0.0.0.0
SYNCTHING_LISTEN_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027
